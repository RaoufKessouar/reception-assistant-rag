# ═══════════════════════════════════════════════════════════
#  Copier ce fichier en `.env` et remplir les valeurs réelles.
#  Le fichier `.env` n'est jamais suivi par Git.
# ═══════════════════════════════════════════════════════════

# ─── Accès Hugging Face (téléchargement des modèles) ───
# HF_TOKEN=

# ─── LLM distant (API compatible OpenAI) ───
# Ne jamais enregistrer une vraie clé dans ce fichier d'exemple.
# RECEPTION_RAG_LLM_BACKEND=openai_compatible
# RECEPTION_RAG_LLM_BASE_URL=https://api.example.com/v1
# RECEPTION_RAG_LLM_MODEL=model-name
# RECEPTION_RAG_LLM_API_KEY=

# ─── Embeddings distants (aucun poids local) ───
# Utiliser de preference le meme modele que l'index existant : BAAI/bge-m3.
# Avec un autre modele ou une autre dimension, reconstruire l'index.
# RECEPTION_RAG_EMBEDDING_BACKEND=openai_compatible
# RECEPTION_RAG_EMBEDDING_BASE_URL=https://api.example.com/v1
# RECEPTION_RAG_EMBEDDING_MODEL=BAAI/bge-m3
# RECEPTION_RAG_EMBEDDING_API_KEY=
# RECEPTION_RAG_EMBEDDING_DENSE_DIM=1024
# RECEPTION_RAG_EMBEDDING_USE_SPARSE=false

# ─── Stockage local Qdrant (mode local) ───
# RECEPTION_RAG_QDRANT_PATH=data/qdrant_storage

# ─── Cache des modèles (HF_HOME) ───
# RECEPTION_RAG_HF_HOME=
